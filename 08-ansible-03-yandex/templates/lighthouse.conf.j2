server {
    listen 80;
    server_name _;

    location / {
        root /var/www/lighthouse;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    location /api {
        # Заглушка, если нужен прокси
        # proxy_pass http://backend;
        return 404;
    }

    error_log /var/log/nginx/lighthouse_error.log;
    access_log /var/log/nginx/lighthouse_access.log;
}